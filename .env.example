# Copie este archivo a .env y ajuste los valores de su entorno local.
# No commitee .env. Las pruebas de integración no leen este archivo:
# obtienen host, puerto y credenciales de los contenedores de Testcontainers.

DATABASE_URL=postgres://catalog:catalog@127.0.0.1:5432/catalog
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
PORT=3000
HOST=127.0.0.1
